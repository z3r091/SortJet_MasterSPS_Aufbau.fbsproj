TYPE Auftragsdaten_ST :
  STRUCT
    wStationsNr                          : WORD;
    wStationsWand                        : WORD;
    rStationsZielposition                : REAL;
    wAuftrag                             : Auftraege_Station_EN; (* Hinweis: Auftragsart -> Ein- Aus- Transport etc.*)
    rAuftragsLaenge                      : REAL;
    rAuftragsHoehe                       : REAL;
    rAuftragsDicke                       : REAL;
    wAnzahlScheiben                      : WORD;
    wErsteLetzteScheibe                  : WORD;
    bErsteScheibe                        : BOOL;
    bLetzteScheibe                       : BOOL;
    rModellVersatzVorne                  : REAL;
    rModellVersatzHinten                 : REAL;
    bModell                              : BOOL;
    wBeschichtung                        : WORD;

    stAuftragsInformationen              : Auftragsinformationen_ST;

    wTransferstationsNr1                 : WORD;
    wTransferstationsNr2                 : WORD;
    rTransferposition1                   : REAL;
    rTransferposition2                   : REAL;
    wTransferwand                        : WORD;
	  wTransferVersatzVorne                : REAL;
	  wTransferVersatzHinten               : REAL;

    stAuftragsOptionen                   : Auftrags_Optionen_ST;

    (*Verfahrlogik_Neu*)
