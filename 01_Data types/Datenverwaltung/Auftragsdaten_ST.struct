    rVorabUpdateZeit                     : REAL;
    rVorabBeschleunigung                 : REAL;
    rVorabBremsrampe                     : REAL;
    rVorabGeschwindigkeit                : REAL;
    rNennstromBeschleunigungsphase       : REAL;
    rNennstromKonstantfahrt              : REAL;
