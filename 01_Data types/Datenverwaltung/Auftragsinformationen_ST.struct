TYPE Auftragsinformationen_ST :
  STRUCT
    wAuftragsInformationen               : WORD;
	 
	 // Das Attribute 'relative_offset' erstzen die Funktion Bitaccess 
	{attribute 'relative_offset' := '0'}	
	
	// Die Bytes im Word werden getauscht
	cBIT_SRC_WALL_2_EMPTY      : BIT; // Quellstation Wand 2 nach Ein/Austransport leer
	cBIT_TRANSPORT_AUFGEKIPPT  : BIT; // Kipp-Shuttle: 1 = Shuttle Transport zum Start Vertikal - nicht Waagerecht
	cBIT_BUFFERSLOT_THICKNESS  : BIT; // Slot Thickness 0=thin/1=thick
	cBit_11                    : BIT; // Scheibe nach Systemcheck abnehmen
	cBit_12                    : BIT; // Scheibe nach Systemcheck abnehmen
	cBit_13                    : BIT;
	cBit_14                    : BIT;
	cBit_15                    : BIT;
	cBIT_AUFTRAGSTYP           : BIT; // 1=Eintransport 0=Austransport 
	cBIT_SRCSTATION_EMPTY      : BIT; // Quellstation im Anschluss leer
	cBIT_TARGET_FW             : BIT; // Ziel Faecherwagen
	cBIT_WALL_1_EMPTY          : BIT; // NUR Shuttlestation (!) Wand 1 (der Shuttlestation) nach Austransport leer
	cBIT_WALL_2_EMPTY          : BIT; // NUR Shuttlestation (!) Wand 2 (der Shuttlestation) nach Austransport leer
	cBIT_WALL_3_EMPTY          : BIT; // NUR Shuttlestation (!) Wand 3 (der Shuttlestation) nach Austransport leer
	cBIT_WALL_4_EMPTY          : BIT; // NUR Shuttlestation (!) Wand 4 (der Shuttlestation) nach Austransport leer
	cBIT_SRC_WALL_1_EMPTY      : BIT; // Quellstation Wand 1 nach Ein/Austransport leer

  END_STRUCT

END_TYPE