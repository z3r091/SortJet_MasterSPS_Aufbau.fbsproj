TYPE Parameter_Drehen :
  STRUCT
    tZeitAntriebsfreigabeErhalten  : TIME;      // [ms \ s] Energieeinsparrung: Zeiteinheit nach der die Antriebsfreigabe entzogen werden soll wenn keine Aktion ansteht [1 s = 1000 ms ]
    rToleranz                      : REAL;      // Toleranz beim Entscheiden der aktuellen Position
    rDrehposition_0_Grad           : REAL;      // Drehposition fuer die 0 Grad
    rDrehposition_90_Grad          : REAL;      // Drehposition fuer die 90 Grad
    rDrehposition_180_Grad         : REAL;      // Drehposition fuer die 180 Grad
    rDrehposition_270_Grad         : REAL;      // Drehposition fuer die 270 Grad
    bArretierung                   : BOOL;      // Arretierung vorhanden
    eZielDrehpositionLeer          : Drehen_EN; // derzeit ohne Funktion
  END_STRUCT
END_TYPE