TYPE Parameter_TransfershuttleGlastransport :
  STRUCT
    rlLaengeStation                            : REAL; // Länge der Station
    rStopFreiFahren                            : REAL; // So weit soll die Scheibe beim Austransport länger fahren
    rWegUeberEinlaufEintransport               : REAL; // Eintransport vorwaerts: Abstand Scheibenhinterkante zum Einlaufsensor [mm]
    rWegUeberEinlaufAustransport               : REAL; // Lage Auf Einlauf: Scheibe liegt um diesen Weg auf dem Einlaufsensor [mm]
    rWegUeberAuslaufEintransport               : REAL; // Eintransport rueckwaerts: Abstand Scheibenhinterkante zum Auslaufsensor [mm]
    rWegUeberAuslaufAustransport               : REAL; // Lage Auf Auslauf: Weg ueber den Auslaufsensor hinaus [mm]
    wEnergieSparZeit                           : WORD; // in Sec, Zeitspanne nach der, der Antrieb deaktiviert wird wenn er keinen Auftrag hat
    rMaxPosAuslaufSensorFreiFahren             : REAL; // Bestimmt die Strecke die Maximal zurueck gefahren werden soll bis der Auslaufsensor  wieder frei ist
    rMaxPosEinlaufSensorFreiFahren             : REAL; // So weit darf maximal der Einlaufsensor frei gefahren weirden
    rgAbstandLuftAbfrageAuslaufShuttle         : REAL; // Abstand in mm von der Einlaufluftschranke zum Inputshuttle Auslaufsensor
  END_STRUCT
END_TYPE