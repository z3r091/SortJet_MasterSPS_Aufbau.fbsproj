    rWegUeberEinlaufEintransport               : REAL; (* So weit soll der Einlaufsensor überfahren werden *)
    rWegUeberEinlaufAustransport               : REAL; (* So weit soll der Einlaufsensor überfahren werden *)
    rWegUeberAuslaufEintransport               : REAL; (* So weit soll der Einlaufsensor überfahren werden *)
    rWegUeberAuslaufAustransport               : REAL; (* So weit soll der Einlaufsensor überfahren werden *)
