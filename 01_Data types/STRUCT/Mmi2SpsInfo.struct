    wTransfershuttle_Nummer1        : WORD; // HINWEIS: Transfer - Shuttlenummer
    wTransfershuttle_Nummer2        : WORD; // HINWEIS: Transfer - Shuttlenummer
    wTransfershuttle_GlasDicke      : WORD; // HINWEIS: Unterteilung welche Luftabfrage genommen werden muss
    rTransfershuttle_SollPosition1  : REAL; // HINWEIS: Soll-Position wo der Speicher geprueft werden soll
    rTransfershuttle_SollPosition2  : REAL; // HINWEIS: Soll-Position wo der Speicher geprueft werden soll

