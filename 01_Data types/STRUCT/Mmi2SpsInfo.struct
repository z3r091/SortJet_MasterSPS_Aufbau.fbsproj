    dwInsertInputShuttleDataJobId            : DWORD;
    wCancelInputShuttleData                  : WORD;
    wInsertInputShuttleDataCoatedSide        : WORD;
    wInsertExtractionShuttleDataTrayNr       : WORD; // NEUER Parameter für neue Nachricht Austransportschlitten
