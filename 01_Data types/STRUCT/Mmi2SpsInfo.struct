TYPE Mmi2SpsInfo :
  STRUCT
    wAutomatikStart                          : WORD;
    wInsertInputShuttleDataTrayNr            : WORD;
    rInsertInputShuttleDataLaenge            : REAL;
    rInsertInputShuttleDataBreite            : REAL;
    rInsertInputShuttleDataDicke             : REAL;
