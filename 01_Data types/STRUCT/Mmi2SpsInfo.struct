    wDeleteStationNr                         : WORD;
    wDeleteStationSlot                       : WORD;
    rDestinationPosition                     : REAL;
    wAuftragsArt                             : WORD; // 0 = Glastransport auf das Shuttle / 1 = Glastransport vom Shuttle Runter
    wModellStatusShutle                      : WORD; // Modelkennung 0 = kein Modell, 1 = Modell
    wShuttlePalette                          : WORD; // (Output-)Shuttle Glastransportwand 0 = vordere Wand / 1 = hintere Wand / in der 2 Wändeausführung
    rModellversatzHintenShuttle              : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik
    rModellVersatzVorneShuttle               : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik
