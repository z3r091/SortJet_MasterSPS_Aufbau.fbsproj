    wAuftragsId                              : WORD; (* 0 = normaler Auftrag Scheibe an ISO,
                                                        1 = aktutelle Scheibe auf Iso Line ausschleusen ,
                                                        2 = Kein Shuttle Transport Warten bis Scheibe Scheibe ausgeschleust wurde
                                                        3 = Kein Shuttle Transport Warten bis Scheibe in die ISO Linie geschleust werden*)
    // Messen 2008
    wModellStatus                            : WORD; // Modelkennung 0 = kein Modell, 1 = Modell
    rModellversatzHinten                     : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik berechnet auf höher angebrachte Sensoren (30mm von Nulllinie)
    rModellVersatzVorne                      : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik berechnet auf höher angebrachte Sensoren (30mm von Nulllinie)
    // Sonderlösung
    rModellversatzHinten2                    : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik berechnet auf höher angebrachte Sensoren (120mm von Nulllinie)
    rModellVersatzVorne2                     : REAL; // bei Modellen Weg von Rechteckkante bis Modelrand auf Höhe der Sensorik berechnet auf höher angebrachte Sensoren (120mm von Nulllinie)
    wPrintStatus                             : WORD; // 0 = nicht warten auf Drucker; 1 = warten auf Drucker
    wSourceTable                             : WORD; // 0 = normaler anlegeauftrag; 13 = von links

   // SB0_MMI_SortierungInputInQueue
    wSlotZielStation                         : WORD; // Zielslot an der Folgestation nach dem Anlegen
