TYPE PositionierAuftrag_ST :
  STRUCT
    wStationsNummer                    : WORD; // Hinweis: Stationsnummer
    rSollPosition                      : REAL; // Hinweis: Soll Position (Ziel)
    rBeschleunigungsrampe              : REAL; // Hinweis: Beschleunigungsrampe in mm/s^2
    rVerzoegerungsrampe                : REAL; // Hinweis: Verzögerungsrampe in mm/s^2
    rSollGeschwindigkeit               : REAL; // Hinweis: Soll geschwindigkeit in mm/s^2
    rNennstromBeschleunigungsphase     : REAL; // Hinweis: Nennstrom (A) in der Beschleunigungsphase
    rNennstromKonstantfahrt            : REAL; // Hinweis: Nennstrom (A) in derKonstantfahrt
    rZeitintervalBeschleunigungsphase  : REAL; // Hinweis: Zeit / Dauer der Beschleunigungsphase
    wAuftragstyp                       : WORD; // Hinweis: Vorabauftragstyp 0- Kein Auftrag 1- Auftrag [Ein- / Aus- Transport]
  END_STRUCT
END_TYPE