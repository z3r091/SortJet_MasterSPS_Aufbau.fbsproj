(* Hinweis:
   - Die Nachricht <LAST_SHEET>  bzw. <FIRST SHEET> wird nun pro Wand Bit-Codiert verschickt
     => Bit 0 = Wand 1
     => Bit 1 = Wand 2
     => ...
   - Bsp.: Ist das Bit 2^0 gesetzt so bedeutet dieses entweder erste Scheibe oder letzte Scheibe fuer die Wand je nach dem wie man die Struktur verwendet
*)
TYPE ScheibenStatus_ST :
  STRUCT
	  wScheibenStatus : WORD;
	{attribute 'relative_offset' := '0'}
	cBIT_WAND1 : BIT; //Bit 2^0 = Wand 1
	cBIT_WAND2 : BIT; //Bit 2^1 = Wand 2
	cBIT_WAND3 : BIT; //Bit 2^2 = Wand 3
	cBIT_WAND4 : BIT; //Bit 2^3 = Wand 4
	cBIT_WAND5 : BIT; //Bit 2^4 = Wand 5
	cBIT_WAND6 : BIT; //Bit 2^5 = Wand 6
	cBIT_WAND7 : BIT; //Bit 2^6 = Wand 7
	cBIT_WAND8 : BIT; //Bit 2^7 = Wand 8
	cBIT_WAND9 : BIT; //Bit 2^8 = Wand 9
	cBIT_WAND10 : BIT; //Bit 2^9 = Wand 10
	cBIT_WAND11 : BIT; //Bit 2^10 = Wand 11
	cBIT_WAND12 : BIT; //Bit 2^11 = Wand 12
	cBIT_WAND13 : BIT; //Bit 2^12 = Wand 13
	cBIT_WAND14 : BIT; //Bit 2^13 = Wand 14
	cBIT_WAND15 : BIT; //Bit 2^14 = Wand 15
	cBIT_WAND16 : BIT; //Bit 2^15 = Wand 16

    {bitaccess cBIT_WAND1 0 'Bit 2^0 = Wand 1'}
    {bitaccess cBIT_WAND2 1 'Bit 2^1 = Wand 2'}
    {bitaccess cBIT_WAND3 2 'Bit 2^2 = Wand 3'}
    {bitaccess cBIT_WAND4 3 'Bit 2^3 = Wand 4'}
    {bitaccess cBIT_WAND5 4 'Bit 2^4 = Wand 5'}
    {bitaccess cBIT_WAND6 5 'Bit 2^5 = Wand 6'}
    {bitaccess cBIT_WAND7 6 'Bit 2^6 = Wand 7'}
    {bitaccess cBIT_WAND8 7 'Bit 2^7 = Wand 8'}
    {bitaccess cBIT_WAND9 8 'Bit 2^8 = Wand 9'}
    {bitaccess cBIT_WAND10 9 'Bit 2^9 = Wand 10'}
    {bitaccess cBIT_WAND11 10 'Bit 2^10 = Wand 11'}
    {bitaccess cBIT_WAND12 11 'Bit 2^11 = Wand 12'}
    {bitaccess cBIT_WAND13 12 'Bit 2^12 = Wand 13'}
    {bitaccess cBIT_WAND14 13 'Bit 2^13 = Wand 14'}
    {bitaccess cBIT_WAND15 14 'Bit 2^14 = Wand 15'}
    {bitaccess cBIT_WAND16 15 'Bit 2^15 = Wand 16'}
  END_STRUCT
END_TYPE