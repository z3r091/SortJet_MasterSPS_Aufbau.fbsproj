TYPE Stations_Optionen_Transfershuttle_ST :
  STRUCT  
    bMasterStation                                                : BOOL; // Ob es sich um ein Master (Master-Slave) - Station handelt. Aktuell gebraucht bei Transfershuttle- Verbund
