TYPE Stationsstatus_Visu_ST :
  STRUCT
  
    // Glastransport
    bSensorEinlauf                  : ARRAY [1..3] OF BOOL; // Einlaufsensor vorhanden
    bSensorEinlaufVorab             : ARRAY [1..3] OF BOOL;
    bSensorAuslaufVorab             : ARRAY [1..3] OF BOOL;
    bSensorAuslauf                  : ARRAY [1..3] OF BOOL; // Auslaufsensor vorhanden
    bSensorAuslaufStopp             : ARRAY [1..3] OF BOOL;
  
    // Gebläse
