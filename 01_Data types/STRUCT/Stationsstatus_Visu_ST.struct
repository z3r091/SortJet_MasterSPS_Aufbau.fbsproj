    // Anschläge
    bAnschlagFehler                 : BOOL;
    bAnschlagSensorAusgefahren      : BOOL;
    bAnschlagSensorEingefahren      : BOOL;

    // Hubpalette
    bHubpaletteFehler               : BOOL;
    bHubpaletteSensorAusgefahren    : BOOL;
    bHubpaletteSensorEingefahren    : BOOL;

    // Bewegliche Abschrankung zum Nachfolger
    bAbschrankungFehler             : BOOL;
    bAbschrankungOffen              : BOOL;
