  Maske_Bit_8  : WORD := 2#0000000100000000 ;
  Maske_Bit_9  : WORD := 2#0000001000000000 ;
  Maske_Bit_10 : WORD := 2#0000010000000000 ;
  Maske_Bit_11 : WORD := 2#0000100000000000 ;
  Maske_Bit_12 : WORD := 2#0001000000000000 ;
  Maske_Bit_13 : WORD := 2#0010000000000000 ;
  Maske_Bit_14 : WORD := 2#0100000000000000 ;
  Maske_Bit_15 : WORD := 2#1000000000000000 ;

