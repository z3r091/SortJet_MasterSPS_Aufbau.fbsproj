   apgMKStation208Glastransport : ARRAY[cWAND_1..cANZAHL_WAENDE] OF Parameter_Glastransport := [
    (                                            
      rLaengeStation                        :=  5800, // Länge der Station 
      rScheibenabstand                      :=   300, // Der Abstand zwischen zwei Scheiben auf der Station
      rWegUeberAuslauf                      :=    50, // So weit soll über den Auslaufsensor hinaus gefahren werden
      rWegUeberEinlauf                      :=    50, // So weit soll über den Einlaufsensor hinaus gefahren werden
