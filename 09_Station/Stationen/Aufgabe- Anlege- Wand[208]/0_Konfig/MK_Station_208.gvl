   apgMKStation208Glastransport : ARRAY[cWAND_1..cANZAHL_WAENDE] OF Parameter_Glastransport := [
    (                                            
      rLaengeStation                        :=  5800, // Länge der Station 
      rScheibenabstand                      :=   300, // Der Abstand zwischen zwei Scheiben auf der Station
      rWegUeberAuslauf                      :=    50, // So weit soll über den Auslaufsensor hinaus gefahren werden
      rWegUeberEinlauf                      :=    50, // So weit soll über den Einlaufsensor hinaus gefahren werden
      rWegUeberSensorenSystemCheck          :=    15, // Der Weg der beim Systemcheck über die Sensoren gefahren wird
      rUeberwachungAuslaufsensor            :=   500, // Ueberwachung des Auslaufsensors [Strecke in der der Auslaufsensor Frei / überfahren werden soll]
      rUeberwachungEinlaufsensor            :=   500, // Ueberwachung des Einlaufsensors [Strecke in der der Einlaufsensor Frei / überfahren werden soll]
      rWegUeberEinlaufEintransport          :=    30, // Lücke beim Eintransport zwischen Scheibenhinterkante und Sensor
      rWegUeberEinlaufAustransport          :=    30, // Lücke beim Austransport zwischen Scheibenhinterkante und Sensor
      rWegUeberAuslaufEintransport          :=    30, // Lücke beim Eintransport zwischen Scheibenhinterkante und Sensor
      rWegUeberAuslaufAustransport          :=    15, // Lücke beim Austransport zwischen Scheibenhinterkante und Sensor
      rWegEinlaufsensorZuVorStopSensor      :=  3550, // Weg vom Einlaufsensor bis zwischen den Auslauf- und VorabAuslaufsensor
      rMesstoleranz                         :=    10, // Toleranz-Mass für die Scheibenlaengenmessung 
      rMessstrecke                          :=  3630, // Weg zwischen Einlauf- und Auslaufsensor 
      rWegstreckeBisZurVerzoegerung         :=  3100  // Weg die gefahren werden soll bis der Antrieb abgebremst, dies gilt für Eintransportauftraege die das Bit "Letzte Scheibe" gesetzt haben
    )];

  apgMKStation208Messachse: Parameter_Messachse :=
    (
      rKorrekturOffset                      :=    0, // Dieser Wert wird auf die Zielposition addiert
      rStreckePositionieren                 :=    0  // Startposition zum Scheibe vermessen
    );
    
  apgMKStation208Kippen : Parameter_Kippen :=
