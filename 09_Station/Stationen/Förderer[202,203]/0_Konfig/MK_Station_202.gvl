      rMesstoleranz                         :=   10, // Toleranz-Mass für die Scheibenlaengenmessung                                                                                           
      rMessstrecke                          := 2621, // Weg zwischen Einlauf- und Auslaufsensor                                                                                                
      rWegstreckeBisZurVerzoegerung         := 2100  // Weg die gefahren werden soll bis der Antrieb abgebremst, dies gilt für Eintransportauftraege die das Bit "Letzte Scheibe" gesetzt haben
    )];

