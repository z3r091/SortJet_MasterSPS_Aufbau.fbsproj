      rUeberwachungEinlaufsensor            :=  500, // Ueberwachung des Einlaufsensors [Strecke in der der Einlaufsensor Frei / überfahren werden soll]                                       
      rWegUeberEinlaufEintransport          :=   30, // Lücke beim Eintransport zwischen Scheibenhinterkante und Sensor                                                                        
      rWegUeberEinlaufAustransport          :=   50, // Lücke beim Austransport zwischen Scheibenhinterkante und Sensor                                                                        
      rWegUeberAuslaufEintransport          :=   50, // Lücke beim Eintransport zwischen Scheibenhinterkante und Sensor                                                                        
      rWegUeberAuslaufAustransport          :=   50, // Lücke beim Austransport zwischen Scheibenhinterkante und Sensor                                                                        
      rWegEinlaufsensorZuVorStopSensor      := 5900, // Weg vom Einlaufsensor bis zwischen den Auslauf- und VorabAuslaufsensor                                                                 
      rMesstoleranz                         :=   10, // Toleranz-Mass für die Scheibenlaengenmessung                                                                                           
      rMessstrecke                          := 6021, // Weg zwischen Einlauf- und Auslaufsensor                                                                                                
      rWegstreckeBisZurVerzoegerung         := 5100  // Weg die gefahren werden soll bis der Antrieb abgebremst, dies gilt für Eintransportauftraege die das Bit "Letzte Scheibe" gesetzt haben
    )];

  apgMKStation203Kippen : ARRAY[cWAND_1..cANZAHL_WAENDE] OF Parameter_Kippen := [
