      rMessstrecke                          := 2750, // Weg zwischen Einlauf- und Auslaufsensor                                                                                                
      rWegstreckeBisZurVerzoegerung         := 1900  // Weg die gefahren werden soll bis der Antrieb abgebremst, dies gilt für Eintransportauftraege die das Bit "Letzte Scheibe" gesetzt haben
    )];

