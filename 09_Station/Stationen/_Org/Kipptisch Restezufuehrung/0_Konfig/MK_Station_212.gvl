      rMesstoleranz                         :=   10, // Toleranz-Mass für die Scheibenlaengenmessung                                                                                           
      rMessstrecke                          := 3590, // Weg zwischen Einlauf- und Auslaufsensor                                                                                                
      rWegstreckeBisZurVerzoegerung         := 2100  // Weg die gefahren werden soll bis der Antrieb abgebremst, dies gilt für Eintransportauftraege die das Bit "Letzte Scheibe" gesetzt haben
    );

  apgMKStation212Querfahrt : Parameter_Querfahrt :=
    (
      rZeitAntriebsfreigabeErhalten          := 180,  // [s] Energieeinsparrung: Zeiteinheit nach der die Antriebsfreigabe entzogen werden soll wenn keine Aktion ansteht [1 s = 1000 ms ] *)
