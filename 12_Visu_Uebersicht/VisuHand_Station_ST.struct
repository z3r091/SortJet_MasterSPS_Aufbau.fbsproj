TYPE VisuHand_Station_ST :
STRUCT
  bGesperrt   : BOOL;                         // TRUE -> Taster ausgeblendet (grau)
  sSperrgrund : STRING(60);
  dwSperrFarbe: DWORD := 16#FF9AA5B1;
  bResetTaster   : BOOL;                      // Visu-Taster "Reset" (Tap)
  bResetGesperrt : BOOL;                      // TRUE -> Reset-Taster ausgegraut
  abZeileVorhanden : ARRAY[1..10] OF BOOL := [10(TRUE)]; // Funktionszeile laut MK-Stationsaufbau vorhanden
  asStatus    : ARRAY[1..10] OF STRING(30);   // Rueckmeldung je Funktionszeile
  adwStatus   : ARRAY[1..10] OF DWORD;        // Farbe je Funktionszeile (ARGB)
END_STRUCT
END_TYPE