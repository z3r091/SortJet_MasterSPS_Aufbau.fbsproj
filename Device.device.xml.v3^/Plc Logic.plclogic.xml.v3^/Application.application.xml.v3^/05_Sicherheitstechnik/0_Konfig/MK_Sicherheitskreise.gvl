    eaTueren            := [eTuer_Undefiniert],                    // Konfig welche Türen zu dem Sicherheitskreis gehören
    eaDurchgang         := [eDurchgang_Undefiniert]                // Konfig welche Durchgänge zu dem Sicherheitskreis gehören
  )];

apgMKDurchgang : ARRAY [cERSTER_DURCHGANG..cANZAHL_DURCHGANGE] OF Parameter_Durchgang := [
  (
   eDurchgang              := eDurchgang_1,        // Nummer des Durchgangs
   eZuBlockierenderSK      := eSicherheitskreis_3, // Sicherheitskreis, der beim Oeffnen blockiert wird
   bBeweglicheAbschrankung := FALSE,               // bewegliche Abschrankung am Durchgang vorhanden
   wMeldungsNummer         := 0                    // Basis-Meldungsnummer (WatchIO)
