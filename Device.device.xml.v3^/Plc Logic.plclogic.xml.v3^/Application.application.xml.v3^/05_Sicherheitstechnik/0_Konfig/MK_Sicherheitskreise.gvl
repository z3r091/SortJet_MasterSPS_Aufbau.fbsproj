    eaAutomatikkreis    := [eAutomatikkreis_4],                    // Konfig welcher Automatikkreis zu dem Sicherheitskreis gehören
    eaTueren            := [eTuer_Undefiniert],                    // Konfig welche Türen zu dem Sicherheitskreis gehören
    eaDurchgang         := [eDurchgang_1]                          // Konfig welche Durchgänge zu dem Sicherheitskreis gehören
  ),
  (
    eSicherheitskreis   := eSicherheitskreis_5,                    // Nummer des Sicherheitskreises
    eaAutomatikkreis    := [eAutomatikkreis_1],                    // Konfig welcher Automatikkreis zu dem Sicherheitskreis gehören
