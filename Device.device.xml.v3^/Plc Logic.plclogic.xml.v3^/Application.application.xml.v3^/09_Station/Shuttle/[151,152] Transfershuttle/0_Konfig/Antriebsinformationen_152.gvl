{attribute 'allow_unqualified_access'}
NAMESPACE Antriebsinformationen_152
VAR_GLOBAL

//-------------------------------------------------------------------------------------------------
// ANTRIEBSINFORMATION TRANSFERSHUTTLE
//-------------------------------------------------------------------------------------------------

  apgInfoTransfershuttle152Querfahrt : AntriebsInformationen :=
    (
      wAchsID                                 :=         2,  // Achs ID aus dem EConSet
      stTyp                                   := 'Lateral',  // Typ
      wpSchaltschrank                         :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanreihe                       :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanseite                       :=        60,  // Daten aus dem Schaltplan
      rpMaxGeschwindigkeit                    :=      3333,  // [mm/s]   Max- Geschwindigkeit für den Automatikbetrieb
      rpHandGeschwindigkeit                   :=       200,  // [mm/s]   Hand- Geschwindigkeit
      rpReferenzGeschwindigkeit               :=        50,  // [mm/s]   Geschwindigkeit für die Referenzfahrt
      rpMaxBeschleunigung                     :=      4000,  // [mm/s^2] Max Beschleunigung
      rpMaxVerzoegerung                       :=      4000,  // [mm/s^2] Max Verzoegerung
      rpMaxRuckzeit                           :=       300,  // [ms]     Ruckzeit des Antriebs
      rpReduzierteBeschleunigung              :=      4000,  // [mm/s^2] Reduzierte Beschleunigung
      rpReduzierteVerzoegerung                :=      4000,  // [mm/s^2] Reduzierte Verzoegerung
      rpEinrichtGeschwindigkeit               :=        50,  // [mm/s]   Max Geschwindigkeit während der Einrichtung der Anlage
      rpReduzierteGeschwindigkeit             :=       0.0,  // [mm/s]   Reduzierte Geschwindigkeit
      rpBeschleunigungFremdanlage             :=       0.0,  // [mm/s^2] Beschleunigung zu einer Fremdanlage
      rpGeschwindigkeitMessen                 :=       0.0,  // [mm/s] Geschwindigkeit beim Scheiben messen
      rpGeschwindigkeitSystemcheck            :=     500.0,  // [mm/s]   Geschwindigkeit im Systemcheck (nur Glastransport)
      rpGeschwindigkeitSystemcheckReduzierung :=     167.0,  // [mm/s]   Geschwindigkeit im Systemcheck bei belegtem Vorstop-Sensor (nur Glastransport)
      stOptionen                              := ( eEndschalterQuelle    := Endschalterquelle_EN.UMRICHTER, // Hardware-Endschalter: KEINE, UMRICHTER oder SPS
                                                   bVersorgungUeberXVR   := FALSE,                          // XVR-Modus: brueckt Hauptschalter 400 V und LS 230 V
                                                   bBremseLoesenFreigabe := FALSE )                         // Der Antrieb darf über eine Betriebsart die Bremse lösen
    );

  apgInfoTransfer152Glastransport : ARRAY[cWAND_1..cANZAHL_WAENDE] OF AntriebsInformationen := [
    (
      wAchsID                                 :=         3,  // Achs ID aus dem EConSet
      stTyp                                   :=    'Belt',  // Typ
      wpSchaltschrank                         :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanreihe                       :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanseite                       :=        65,  // Daten aus dem Schaltplan
      rpMaxGeschwindigkeit                    :=       667,  // [mm/s]   Max- Geschwindigkeit für den Automatikbetrieb
      rpHandGeschwindigkeit                   :=       200,  // [mm/s]   Hand- Geschwindigkeit
      rpReduzierteGeschwindigkeit             :=        67,  // [mm/s]   Reduzierte Geschwindigkeit
      rpReferenzGeschwindigkeit               :=         0,  // [mm/s]   Geschwindigkeit für die Referenzfahrt
      rpEinrichtGeschwindigkeit               :=        50,  // [mm/s]   Max Geschwindigkeit während der Einrichtung der Anlage
      rpMaxBeschleunigung                     :=      1500,  // [mm/s^2] Max Beschleunigung
      rpMaxVerzoegerung                       :=      2000,  // [mm/s^2] Max Verzoegerung
      rpMaxRuckzeit                           :=        50,  // [ms]     Ruckzeit des Antriebs
      rpReduzierteBeschleunigung              :=      1000,  // [mm/s^2] Reduzierte Beschleunigung
      rpReduzierteVerzoegerung                :=      1000,  // [mm/s^2] Reduzierte Verzoegerung
      rpBeschleunigungFremdanlage             :=      1000,  // [mm/s^2] Beschleunigung zu einer Fremdanlage
      rpGeschwindigkeitMessen                 :=       667,  // [mm/s] Geschwindigkeit beim Scheiben messen
      rpGeschwindigkeitSystemcheck            :=     500.0,  // [mm/s]   Geschwindigkeit im Systemcheck (nur Glastransport)
      rpGeschwindigkeitSystemcheckReduzierung :=     167.0,  // [mm/s]   Geschwindigkeit im Systemcheck bei belegtem Vorstop-Sensor (nur Glastransport)
      stOptionen                              := ( eEndschalterQuelle    := Endschalterquelle_EN.KEINE,     // Hardware-Endschalter: KEINE, UMRICHTER oder SPS
                                                   bVersorgungUeberXVR   := FALSE,                          // XVR-Modus: brueckt Hauptschalter 400 V und LS 230 V
                                                   bBremseLoesenFreigabe := FALSE )                         // Der Antrieb darf über eine Betriebsart die Bremse lösen
    )];

  apgInfoTransfer152GlastransportSlave : ARRAY[cWAND_1..cANZAHL_WAENDE] OF AntriebsInformationen := [
    (
      wAchsID                                 :=        65,  // Achs ID aus dem EConSet
      stTyp                                   :=  'BeltSl',  // Typ
      wpSchaltschrank                         :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanreihe                       :=         2,  // Daten aus dem Schaltplan
      wpSchaltplanseite                       :=        65,  // Daten aus dem Schaltplan
      rpMaxGeschwindigkeit                    :=         0,  // [mm/s]   Max- Geschwindigkeit für den Automatikbetrieb
      rpHandGeschwindigkeit                   :=         0,  // [mm/s]   Hand- Geschwindigkeit
      rpReduzierteGeschwindigkeit             :=         0,  // [mm/s]   Reduzierte Geschwindigkeit
      rpReferenzGeschwindigkeit               :=         0,  // [mm/s]   Geschwindigkeit für die Referenzfahrt
      rpEinrichtGeschwindigkeit               :=         0,  // [mm/s]   Max Geschwindigkeit während der Einrichtung der Anlage
      rpMaxBeschleunigung                     :=         0,  // [mm/s^2] Max Beschleunigung
      rpMaxVerzoegerung                       :=         0,  // [mm/s^2] Max Verzoegerung
      rpMaxRuckzeit                           :=         0,  // [ms]     Ruckzeit des Antriebs
      rpReduzierteBeschleunigung              :=         0,  // [mm/s^2] Reduzierte Beschleunigung
      rpReduzierteVerzoegerung                :=         0,  // [mm/s^2] Reduzierte Verzoegerung
      rpBeschleunigungFremdanlage             :=         0,  // [mm/s^2] Beschleunigung zu einer Fremdanlage
      rpGeschwindigkeitMessen                 :=         0,  // [mm/s] Geschwindigkeit beim Scheiben messen
      rpGeschwindigkeitSystemcheck            :=     500.0,  // [mm/s]   Geschwindigkeit im Systemcheck (nur Glastransport)
      rpGeschwindigkeitSystemcheckReduzierung :=     167.0,  // [mm/s]   Geschwindigkeit im Systemcheck bei belegtem Vorstop-Sensor (nur Glastransport)
      stOptionen                              := ( eEndschalterQuelle    := Endschalterquelle_EN.KEINE,     // Hardware-Endschalter: KEINE, UMRICHTER oder SPS
                                                   bVersorgungUeberXVR   := FALSE,                          // XVR-Modus: brueckt Hauptschalter 400 V und LS 230 V
                                                   bBremseLoesenFreigabe := FALSE )                         // Der Antrieb darf über eine Betriebsart die Bremse lösen
    )];

END_VAR
END_NAMESPACE