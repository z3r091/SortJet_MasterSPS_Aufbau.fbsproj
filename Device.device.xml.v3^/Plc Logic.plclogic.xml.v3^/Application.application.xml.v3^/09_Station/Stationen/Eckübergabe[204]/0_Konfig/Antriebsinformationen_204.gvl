  // X-Achse
  apgInfoStation204Glastransport : ARRAY[cWAND_1..cANZAHL_WAENDE] OF AntriebsInformationen := [
    (
      wAchsID                                 :=     22,  // Achs ID aus dem EConSet - TODO: vorlaeufig freie ID, aus EConSet uebernehmen
      stTyp                                   := 'Belt',  // Typ
      wpSchaltschrank                         :=   2050,  // Daten aus dem Schaltplan
      wpSchaltplanreihe                       :=      2,  // Daten aus dem Schaltplan
      wpSchaltplanseite                       :=    100,  // Daten aus dem Schaltplan
      rpMaxGeschwindigkeit                    :=   1000,  // [mm/s]   Max- Geschwindigkeit für den Automatikbetrieb
      rpHandGeschwindigkeit                   :=    333,  // [mm/s]   Hand- Geschwindigkeit
      rpReduzierteGeschwindigkeit             :=    250,  // [mm/s]   Reduzierte Geschwindigkeit
      rpReferenzGeschwindigkeit               :=      0,  // [mm/s]   Geschwindigkeit für die Referenzfahrt
      rpEinrichtGeschwindigkeit               :=     50,  // [mm/s]   Max Geschwindigkeit während der Einrichtung der Anlage
      rpMaxBeschleunigung                     :=   1500,  // [mm/s^2] Max Beschleunigung
      rpMaxVerzoegerung                       :=   2000,  // [mm/s^2] Max Verzoegerung
      rpMaxRuckzeit                           :=     50,  // [ms]     Ruckzeit des Antriebs
      rpReduzierteBeschleunigung              :=   1000,  // [mm/s^2] Reduzierte Beschleunigung
      rpReduzierteVerzoegerung                :=   1000,  // [mm/s^2] Reduzierte Verzoegerung
      rpBeschleunigungFremdanlage             :=   1000,  // [mm/s^2] Beschleunigung zu einer Fremdanlage
      rpGeschwindigkeitMessen                 :=    667,  // [mm/s] Geschwindigkeit beim Scheiben messen
      rpGeschwindigkeitSystemcheck            :=  500.0,  // [mm/s]   Geschwindigkeit im Systemcheck (nur Glastransport)
      rpGeschwindigkeitSystemcheckReduzierung :=  167.0,  // [mm/s]   Geschwindigkeit im Systemcheck bei belegtem Vorstop-Sensor (nur Glastransport)
      stOptionen                              := ( eEndschalterQuelle    := Endschalterquelle_EN.KEINE,     // Hardware-Endschalter: KEINE, UMRICHTER oder SPS
                                                   bVersorgungUeberXVR   := FALSE,                          // XVR-Modus: brueckt Hauptschalter 400 V und LS 230 V
                                                   bBremseLoesenFreigabe := FALSE )                         // Der Antrieb darf über eine Betriebsart die Bremse lösen
    )];

