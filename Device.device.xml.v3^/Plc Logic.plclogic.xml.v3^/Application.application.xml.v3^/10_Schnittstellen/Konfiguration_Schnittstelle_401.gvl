NAMESPACE Konfiguration_Schnittstelle_401
VAR_CONFIG

//-------------------------------------------------------------------------------------------------
// KONFIGURATION: SCHNITTSTELLE 401 Auslauf Glaston mit Koppler
//-------------------------------------------------------------------------------------------------
  // ------------------------------------ HARDWARE EINGAENGE ---------------------------------------
  // Standard Eingaenge
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_bTasterGlasbruch                          AT %MX1.0    : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_bTasterSpezial                            AT %MX1.0    : BOOL; // OPTION
  // Koppler Eingaenge (Empfaenger -> Sender)
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_wEmpfaengerLiveCounter                    AT %MW100    : WORD; // OPTION - Wort 0 LiveCounter gespiegelt
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_awEmpfaengerLadeIDGespiegelt              AT %MW100    : ARRAY [1..8] OF WORD; // OPTION - Wort 1..8 Lade-ID gespiegelt
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_wEmpfaengerSignale                        AT %MW100    : WORD; // OPTION - Wort 49 Signale
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_dwEmpfaengerGeschwindigkeit               AT %MD50     : DWORD; // OPTION - Wort 50 Geschwindigkeit [mm/s]
  Globale_Bausteine.aSchnittstelleAuslauf[401].in_wEmpfaengerRampe                          AT %MW100    : WORD; // OPTION - Wort 52 Rampe [mm/s2]

  // ------------------------------------ HARDWARE AUSGAENGE ---------------------------------------
  // Standard Ausgaenge
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_bSenderBereit                            AT %MX4010.0 : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_bSenderGlasBereit                        AT %MX4010.1 : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_bLeuchteGlasbruch                        AT %MX4010.2 : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_bLeuchteSpezial                          AT %MX4010.3 : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_bAmpelEventAktiv                         AT %MX4010.4 : BOOL; // OPTION
  Globale_Bausteine.aSchnittstelleAuslauf[401].Horn.out_bHorn                               AT %MX4010.5 : BOOL; // OPTION
  // Koppler Ausgaenge (Sender -> Empfaenger)
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_wSenderLiveCounter                       AT %MW4010   : WORD; // OPTION - Wort 0 LiveCounter
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_wSenderSignale                           AT %MW4011   : WORD; // OPTION - Wort 50 Signale
  Globale_Bausteine.aSchnittstelleAuslauf[401].out_awSenderLadeID                           AT %MW4012   : ARRAY [1..8] OF WORD; // OPTION - Wort 1..8 Lade-ID (%MW4012..%MW4019)

END_VAR

END_NAMESPACE