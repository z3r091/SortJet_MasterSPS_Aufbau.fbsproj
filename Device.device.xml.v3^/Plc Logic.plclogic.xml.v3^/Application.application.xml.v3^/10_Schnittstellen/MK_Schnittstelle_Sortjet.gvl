{attribute 'allow_unqualified_access'}
NAMESPACE MK_Schnittstelle_Sortjet
VAR_GLOBAL
//-------------------------------------------------------------------------------------------------
// MASCHINEPARAMETER: SCHNITTSTELLE SORTJET
//-------------------------------------------------------------------------------------------------

  (* Hinweis:
     - Das MMI entscheidet wer Master und wer Slave ist.
       Das MMI, das den Status der Verbundstrecke verwaltet ist der Master!
  *)
  apgMKSchnittstelle_SortJet_Remnant : Schnittstelle_SortJet_ST :=
  (
    bDeaktivieren      := FALSE,                // Station deaktiviert (keine Auftraege, keine Referenzfahrt)
    eSchnittstellenTyp := eSchnittstelle_Master // Rolle der SortJet-SortJet-Schnittstelle (Master/Slave)
  );

END_VAR
END_NAMESPACE