(* METADATA
{
  "v3Meta": {
    "objectGuid": "40b5e71b-f854-4565-9b77-acb7772a88ea"
  }
}
*)
{attribute 'allow_unqualified_access'}
NAMESPACE MK_Station_501
VAR_GLOBAL
//-------------------------------------------------------------------------------------------------
// MASCHINEPARAMETER: SCHNITTSTELLE 501
//-------------------------------------------------------------------------------------------------

  apgMKStation501 : Parameter_Station :=
    (
      stStationsNummern                     := ( NummerIntern    :=   501,                           // Stationsnummer fuer das MMI und die Stationsangabe der Meldungen
                                                 NummerExtern    :=  1501,                           // Stationsnummer fuer Bedienermeldungen
                                                 NummerSPS       :=   501 ),                         // Stationsnummer SPS-intern (Indizes)
      bDeaktivieren                         := FALSE,                                                // Station deaktiviert (keine Auftraege, keine Referenzfahrt)
      wMeldungsNummer                       := 1310,                                                 // Basis-Meldungsnummer (WatchIO)
      eStationsTyp                          := eFremdanlage,                                         // Typ der Station
      eaAutomatikkreis                      := [eAutomatikkreis_Undefiniert],                        // Automatikkreise, zu denen die Station gehoert
      // stStationsOptionen
      // stStationsAufbau
      // stStationsParameter
      stSchnittstellendaten                 := ( wVorgaengerStation := cSTATION_DEFAULT,             // Station vor dieser Station (cSTATION_DYNAMISCH bei mehreren)
                                                 wNachfolgerStation := cSTATION_205,                 // Station nach dieser Station (cSTATION_DYNAMISCH bei mehreren)
                                                 bStationIstShuttle := FALSE                         // Station ist ein Shuttle
                                               ),
      stFremdanlage                         := ( bWerteSwappen                          := FALSE,    // Bytes der Auftragsdaten (Lade-ID) und der Empfaenger- Geschwindigkeit swappen
                                                 bCounterSwappen                        := FALSE,    // Nur die bytes von Life Counter swappen
                                                 bSignaleSwappen                        := FALSE,    // Nur die bytes der Signale swappen
                                                 bAnzahlScheibenSwappen                 := FALSE,    // Nur die Bytes der Anzahl Scheiben swappen
                                                 bRemoveETX                             := TRUE,     // ETX aus den Scheiben-IDs des MMI entfernen (Auftragsdaten Fremdanlage)
                                                 tZeitHornAktiv                         := T#5S,     // Signal bei ISO-Line Event
                                                 rAnalogWertVerhaeltniss                := 32.768,   // Umrechnungsfaktor für den Analogwert
                                                 rLaengeStation                         := 0.0,      // Laenge der Fremdanlage (Wegueberwachung der ersten Scheibe in der Nachbarstation), 0 = unbekannt
                                                 wMindestAnalogWert                     := 100,      // Mindestwert, den der Analogwert haben muss um gültig zu sein
                                                 bAnzeigeISOLinieEventAktiv             := FALSE,    // ISO Line Events sollen angezeigt werden
                                                 bAnalogwertAktiv                       := FALSE,    // Geschwindigkeit - Analog | Statische
                                                 rGeschwindigkeit                       := 350,      // Feste Geschwindigkeit der Fremdanlage - (Fester Sollwert)
                                                 rMindestGeschwindigkeitsAenderung      := 5.0,      // Glaettung: Mindestaenderung [mm/s] bevor eine neue Geschwindigkeit uebernommen wird
                                                 tMindestZeitZwischenGeschwAenderung    := T#500MS,  // Glaettung: Mindestzeit zwischen zwei Geschwindigkeitsaenderungen
                                                 rMaxAnalogGeschwindigkeit              := 1000.0,   // Analogwert: Begrenzung der Geschwindigkeit [mm/s]
                                                 eTypSchnittstelle                      := eDefault, // Variante der Schnittstelle
                                                 bStationStatusZuGlasAbruf              := FALSE,    // Stationsstatus beim Glasabruf melden (ISO-Linie)
                                                 bSignaleLoggen                         := TRUE      // Schnittstellensignale loggen
                                               ),
      // stGlasdaten
      eaSicherheitskreis                    := [eSicherheitskreis_Undefiniert],                      // Sicherheitskreise, in die die Station eingebunden ist
      eSystemcheckZyklus                    := eSystemcheckZyklus_Undefiniert                        // In welchem Zyklus des Systemchecks die Station geprueft wird
      // astShuttleAnhaltenQuellen
   );
 
END_VAR
END_NAMESPACE